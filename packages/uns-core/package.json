{
  "name": "@uns-kit/core",
  "version": "3.0.9",
  "description": "Core utilities and runtime building blocks for UNS-based realtime transformers.",
  "type": "module",
  "license": "MIT",
  "author": "Aljoša Vister <aljosa.vister@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/uns-openhub/uns-kit.git",
    "directory": "packages/uns-core"
  },
  "keywords": [
    "uns",
    "unified-namespace",
    "mqtt",
    "iot",
    "typescript",
    "realtime"
  ],
  "files": [
    "dist",
    "MIGRATIONS.md"
  ],
  "exports": {
    "./*": "./dist/*",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-static-assets.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync-uns-schema": "tsx src/tools/sync-uns-schema.ts",
    "sync-uns-metadata": "tsx src/tools/sync-uns-metadata.ts",
    "postversion": "node ../../scripts/update-cli-package-version.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@infisical/sdk": "^5.0.2",
    "azure-devops-node-api": "^15.1.2",
    "chalk": "^5.6.2",
    "fs-extra": "^11.4.0",
    "get-port": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.2",
    "pkg-dir": "^9.0.0",
    "prettier": "^3.9.6",
    "simple-git": "^3.36.0",
    "tsx": "^4.23.8",
    "winston": "^3.19.0",
    "winston-gelf": "^1.7.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3",
    "zod-to-ts": "^2.1.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1"
  }
}
