{
  "infra": {
    "host": "localhost"
  },
  "uns": {
    "processName": "example-configured-catalog",
    "instanceMode": "wait",
    "handover": false,
    "jwksWellKnownUrl": "http://localhost:3200/api/.well-known/jwks.json"
  },
  "mqtt": {
    "username": {
      "provider": "env",
      "key": "MQTT_USERNAME",
      "default": ""
    },
    "password": {
      "provider": "env",
      "key": "MQTT_PASSWORD",
      "default": ""
    }
  },
  "source": {
    "topic": "example/private/line-1/equipment/main/temperature"
  }
}
