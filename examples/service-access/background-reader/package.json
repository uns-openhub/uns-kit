{
  "name": "example-background-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config-example.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@uns-kit/core": "^3.0.49"
  },
  "unsDatahub": {
    "schemaVersion": 1,
    "kind": "addon",
    "controllerCompatibility": ">=2 <3",
    "serviceAccess": {
      "protocol": 1,
      "permissions": {
        "scopes": [
          "read:uns"
        ],
        "accessRules": [
          "example/background/line-1/equipment/main/temperature"
        ]
      }
    }
  }
}
